<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Author>ViewInFFXIV</Author>
    <AssemblyName>ViewInFFXIV</AssemblyName>
    <Name>ViewInFFXIV</Name>
    <InternalName>ViewInFFXIV</InternalName>
    <DalamudApiLevel>15</DalamudApiLevel>
    <Punchline>Put a browser window on a wall in your house.</Punchline>
    <Description>Captures a browser or Discord window and draws it on a 16:9 screen in FFXIV housing. Use your own browser (uBlock, etc.). Open with /viewin.</Description>
    <Tags>utility;housing;video;watchtogether</Tags>
    <RepoUrl>https://github.com/PayneZA/ViewInFFXIV</RepoUrl>
    <MakeZip>true</MakeZip>
    <PictomancyCsproj Condition="'$(PictomancyCsproj)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\ffxiv_pictomancy\Pictomancy\Pictomancy.csproj'))</PictomancyCsproj>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ViewInFFXIV.Shared\ViewInFFXIV.Shared.csproj" />
    <ProjectReference Include="..\ViewInFFXIV.Host\ViewInFFXIV.Host.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(PictomancyCsproj)" />
  </ItemGroup>
  <Target Name="CopyHost">
    <MSBuild Projects="..\ViewInFFXIV.Host\ViewInFFXIV.Host.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_HostTarget" />
    </MSBuild>
    <PropertyGroup>
      <HostTargetPath>@(_HostTarget)</HostTargetPath>
      <HostOut>$([System.IO.Path]::GetDirectoryName($(HostTargetPath)))</HostOut>
    </PropertyGroup>
    <Error Condition="'$(HostOut)' == '' or !Exists('$(HostOut)\ViewInFFXIV.Host.exe')"
           Text="ViewInFFXIV.Host.exe was not built. Expected it next to $(HostTargetPath)." />
    <ItemGroup>
      <_StaleHost Include="$(OutputPath)Host\Microsoft.Web.WebView2*;$(OutputPath)Host\WebView2Loader.dll" />
      <_StaleHost Include="$(OutputPath)Host\*.pdb;$(OutputPath)*.pdb" Condition="'$(Configuration)' == 'Release'" />
      <HostFiles Include="$(HostOut)\**\*.*"
                 Exclude="$(HostOut)\**\*.pdb;$(HostOut)\**\Microsoft.Web.WebView2*;$(HostOut)\**\WebView2Loader.dll;$(HostOut)\**\runtimes\**\*.*" />
    </ItemGroup>
    <Delete Files="@(_StaleHost)" ContinueOnError="true" />
    <ItemGroup>
      <_PdbToStrip Include="$(OutputPath)**\*.pdb" Condition="'$(Configuration)' == 'Release'" />
    </ItemGroup>
    <Delete Files="@(_PdbToStrip)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutputPath)Host\runtimes" ContinueOnError="true" />
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="$(OutputPath)Host\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutputPath)Host\ViewInFFXIV.Host.exe')"
           Text="Failed to copy ViewInFFXIV.Host.exe into $(OutputPath)Host\." />
    <Error Condition="!Exists('$(OutputPath)Host\ViewInFFXIV.Host.runtimeconfig.json')"
           Text="Failed to copy ViewInFFXIV.Host.runtimeconfig.json; the helper will not start." />
    <Error Condition="!Exists('$(OutputPath)Pictomancy.dll')"
           Text="Pictomancy.dll is missing from $(OutputPath). Check PictomancyCsproj=$(PictomancyCsproj)." />
  </Target>
  <PropertyGroup>
    <DistDir>$(MSBuildThisFileDirectory)..\dist\</DistDir>
    <ReleaseZip>$(DistDir)release.zip</ReleaseZip>
    <ReleaseZipVersioned>$(DistDir)ViewInFFXIV-$(Version).zip</ReleaseZipVersioned>
    <StageDir>$(DistDir).stage\</StageDir>
  </PropertyGroup>
  <Target Name="PackRelease" AfterTargets="DefaultDalamudPackagerRelease" DependsOnTargets="CopyHost" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <StalePluginFiles Include="$(OutputPath)InView*" />
      <StaleHostFiles Include="$(OutputPath)Host\InView*" />
      <PluginPack Include="$(OutputPath)*.dll" Exclude="$(OutputPath)InView*.dll;$(OutputPath)InView.*" />
      <PluginPack Include="$(OutputPath)ViewInFFXIV.json" />
      <HostPack Include="$(OutputPath)Host\**\*.*" Exclude="$(OutputPath)Host\**\*.pdb;$(OutputPath)Host\InView*;$(OutputPath)Host\Microsoft.Web.WebView2*;$(OutputPath)Host\WebView2Loader.dll;$(OutputPath)Host\runtimes\**\*.*" />
    </ItemGroup>
    <Delete Files="@(StalePluginFiles)" ContinueOnError="true" />
    <Delete Files="@(StaleHostFiles)" ContinueOnError="true" />
    <RemoveDir Directories="$(StageDir)" ContinueOnError="true" />
    <MakeDir Directories="$(StageDir);$(StageDir)Host;$(DistDir)" />
    <Copy SourceFiles="@(PluginPack)" DestinationFolder="$(StageDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HostPack)" DestinationFolder="$(StageDir)Host\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(HostPack)' != ''" />
    <WriteLinesToFile
      File="$(StageDir)INSTALL.txt"
      Overwrite="true"
      Lines="ViewInFFXIV dev plugin pack;Extract this folder anywhere (keep ViewInFFXIV.dll and Host/ together).;In game: /xlsettings - Experimental - Dev Plugin Locations - add this folder.;Then /xlplugins - Dev Tools - enable ViewInFFXIV.;Requires Dalamud API 15 and .NET 10." />
    <Delete Files="$(ReleaseZip);$(ReleaseZipVersioned)" ContinueOnError="true" />
    <Error Condition="!Exists('$(StageDir)Host\ViewInFFXIV.Host.exe')" Text="dist pack is missing Host\ViewInFFXIV.Host.exe." />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ReleaseZip)" Overwrite="true" />
    <Copy SourceFiles="$(ReleaseZip)" DestinationFiles="$(ReleaseZipVersioned)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Created dev plugin pack: $(ReleaseZip)" />
  </Target>
</Project>
